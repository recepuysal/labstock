{
  "name": "labstock-desktop",
  "version": "1.10.2",
  "private": true,
  "main": "main.js",
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.labstock.web",
    "productName": "LabStock",
    "files": [
      "main.js",
      "preload.js",
      "icon.ico",
      "node_modules/**/*"
    ],
    "afterPack": "afterPack.js",
    "publish": {
      "provider": "github",
      "owner": "recepuysal",
      "repo": "labstock"
    },
    "win": {
      "target": "nsis",
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "LabStock-Kurulum.${ext}",
      "shortcutName": "LabStock v${version}"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
